// Черновая карта REST API: пути, модели и коды ответов не согласованы.
model {
  extend notify.api {
    campaigns = service 'Рассылки' {
      create = service 'POST /campaigns' {
        summary 'Создать рассылку.'
        description '''
          TODO: согласовать поля, сроки и идемпотентность.

          **Пример тела запроса:**

          ```json
          {
            "channel": "channel-sms-1",
            "payload": {
              "body": "Ваша заявка обработана"
            },
            "priority": "normal"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "draft"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      inline = service 'POST /campaigns/inline' {
        summary 'Создать и запланировать небольшую рассылку.'
        description '''
          TODO: решить, нужен ли отдельный inline-сценарий и каковы его пределы.

          **Пример тела запроса:**

          ```json
          {
            "channel": "channel-sms-1",
            "payload": {
              "body": "Ваша заявка обработана"
            },
            "priority": "normal",
            "recipients": [
              "user-456"
            ],
            "scheduled_at": "2026-11-11T09:00:00Z"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "scheduled"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /campaigns/{campaign_id}' {
        summary 'Получить состояние и прогресс рассылки.'
        description '''
          TODO: определить статусы и состав прогресса.

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "sending",
            "processed": 100,
            "accepted": 98,
            "failed": 2
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      batch = service 'POST /campaigns/{campaign_id}/recipients/batch' {
        summary 'Добавить порцию аудитории.'
        description '''
          TODO: определить идемпотентность, ограничения и форматы анонимных получателей.

          **Пример тела запроса:**

          ```json
          {
            "recipient_type": "user_id",
            "recipients": [
              "user-456",
              "user-789"
            ]
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "batch_id": "batch-001",
            "accepted_count": 2
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      start = service 'POST /campaigns/{campaign_id}/start' {
        summary 'Запустить или запланировать рассылку.'
        description '''
          TODO: определить поведение повторного запроса и допустимые переходы.

          **Пример тела запроса:**

          ```json
          {
            "scheduled_at": "2026-11-11T09:00:00Z"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "scheduled"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      cancel = service 'POST /campaigns/{campaign_id}/cancel' {
        summary 'Запросить отмену рассылки.'
        description '''
          TODO: согласовать отмену уже опубликованных и отправленных сообщений.

          **Пример тела запроса:**

          ```json
          {}
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "cancelling"
