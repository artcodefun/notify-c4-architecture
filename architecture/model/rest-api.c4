views {
  view rest_overview of notify.api {
    title 'REST API — группы операций'
    description 'Черновая карта API; контракты и границы доступа предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
  view rest_campaigns of notify.api.campaigns {
    title 'REST API — Рассылки'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_history of notify.api.history {
    title 'REST API — История уведомлений'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
    style read {
      shape rectangle
    }
  }
  view rest_channels of notify.api.channels {
    title 'REST API — Каналы'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_providers of notify.api.providers {
    title 'REST API — Провайдеры'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_applications of notify.api.applications {
    title 'REST API — Мобильные приложения'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_admin of notify.api.admin {
    title 'REST API — Администрирование'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_templates of notify.api.templates {
    title 'REST API — Шаблоны'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
