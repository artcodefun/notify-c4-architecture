// Черновая карта REST API: пути, модели и коды ответов не согласованы.
model {
  extend notify.api {
    campaigns = service 'Рассылки' {
      create = service 'POST /campaigns' {
        summary 'Создать рассылку.'
        description '''
          channel_type обязателен: sms, push или email. Ровно одно из payload или template обязательно. payload имеет единый формат: title, body, image_url и data; адаптер выбранного канала использует только поддерживаемые поля. template передаёт key и фиксируется в актуальной версии при создании кампании. category — обязательная строковая категория, которую вызывающая система задаёт для последующей фильтрации истории уведомлений. Необязательный channel_key задаёт конкретный канал оператора; без ключа выбирается самый дешёвый подходящий канал указанного типа. TODO: согласовать остальные поля, сроки и идемпотентность.

          **Пример тела запроса:**

          ```json
          {
            "channel_type": "sms",
            "channel_key": "channel-sms-twilio-325",
            "category": "informational",
            "payload": {
              "title": "Заявка",
              "body": "Ваша заявка обработана",
              "image_url": "https://example.com/banner.png",
              "data": {"application_id": "123"}
            },
            "priority": "normal"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "draft"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      inline = service 'POST /campaigns/inline' {
        summary 'Создать и запланировать небольшую рассылку.'
        description '''
          channel_type обязателен: sms, push или email. Ровно одно из payload или template обязательно. payload имеет единый формат: title, body, image_url и data; адаптер выбранного канала использует только поддерживаемые поля. template передаёт key и данные подстановки для адресатов. category — обязательная строковая категория, которую вызывающая система задаёт для последующей фильтрации истории уведомлений. Аудитория задаётся так же, как для порции: обязательны recipient_type (user_id, phone, email или push_token) и непустой recipients. API сохраняет её неизменяемым inline_batch вместе с кампанией. Если scheduled_at не задан или уже наступил, кампания сохраняется в started и сразу публикуется в inline run; если время в будущем — в scheduled, а запуск публикует scheduler. Необязательный channel_key задаёт конкретный канал оператора; без ключа сервис выбирает самый дешёвый подходящий канал указанного типа. TODO: решить пределы inline-сценария.

          **Пример тела запроса:**

          ```json
          {
            "channel_type": "sms",
            "channel_key": "channel-sms-twilio-325",
            "category": "informational",
            "template": {
              "key": "hello_template",
              "recipient_data": [
                {
                  "recipient": "user-456",
                  "data": {"name": "Виктор"}
                }
              ]
            },
            "priority": "normal",
            "recipient_type": "user_id",
            "recipients": [
              "user-456"
            ],
            "scheduled_at": "2026-11-11T09:00:00Z"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "scheduled"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /campaigns/{campaign_id}' {
        summary 'Получить состояние и прогресс рассылки.'
        description '''
          Прогресс содержит счётчики обработанных сообщений и terminal-статусов success, fail и canceled. TODO: определить статусы кампании и дополнительные поля прогресса.

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "started",
            "processed": 100,
            "success": 98,
            "fail": 1,
            "canceled": 1
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      batch = service 'POST /campaigns/{campaign_id}/recipients/batch' {
        summary 'Добавить порцию аудитории.'
        description '''
          Допустимые recipient_type: user_id, phone, email, push_token. Для анонимных получателей передаются непосредственные адреса. recipients обязателен и не может быть пустым. Если кампания использует template, объект template содержит recipient_data: массив объектов recipient и data. recipient должен совпадать со значением из recipients; дубли и неизвестные значения отклоняются. TODO: определить идемпотентность, ограничения и правила проверки адресов.

          **Пример тела запроса:**

          ```json
          {
            "recipient_type": "user_id",
            "recipients": [
              "user-456",
              "user-789"
            ],
            "template": {
              "recipient_data": [
                {
                  "recipient": "user-456",
                  "data": {"name": "Виктор"}
                }
              ]
            }
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "batch_id": "batch-001",
            "accepted_count": 2
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      start = service 'POST /campaigns/{campaign_id}/start' {
        summary 'Запустить или запланировать рассылку.'
        description '''
          Запуск завершает загрузку аудитории: последующие порции отклоняются. deadline_at необязателен; при его наступлении новые попытки отправки пропускаются. TODO: определить поведение повторного запроса и допустимые переходы.

          **Пример тела запроса:**

          ```json
          {
            "scheduled_at": "2026-11-11T09:00:00Z",
            "deadline_at": "2026-11-11T12:00:00Z"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "scheduled"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      cancel = service 'POST /campaigns/{campaign_id}/cancel' {
        summary 'Запросить отмену рассылки.'
        description '''
          Фиксирует cancelled_at, не вводя отдельного статуса отмены, и обновляет или инвалидирует кэш рассылки. Воркеры проверяют отмену при обработке; уже принятые провайдером сообщения не отзываются. TODO: определить допустимую задержку обновления кэша и поведение запросов, уже выполняющихся у провайдера.

          **Пример тела запроса:**

          ```json
          {}
          ```

          **Пример тела ответа:**

          ```json
          {
            "campaign_id": "campaign-001",
            "status": "started",
            "cancelled_at": "2026-11-11T09:30:00Z"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
    history = service 'История уведомлений' {
      list = service 'GET /users/{user_id}/notifications' {
        summary 'Получить историю уведомлений пользователя.'
        description '''
          Необязательный query-параметр `category` фильтрует историю по строковой категории, которую указала вызывающая система при создании рассылки. TODO: согласовать набор статусов, остальные фильтры и пагинацию.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "notification_id": "notification-001",
                "delivery_status": "success",
                "receive_status": "sent",
                "channel_type": "sms",
                "channel_key": "channel-sms-1",
                "category": "informational"
              }
            ],
            "next_cursor": null
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      status = service 'PUT /users/{user_id}/notifications/{notification_id}/status' {
        summary 'Установить статус получения сообщения.'
        description '''
          receive_status: sent, delivered или read. delivery_status (pending, success, fail, canceled) устанавливается только delivery и retry-воркерами. TODO: согласовать допустимые переходы, права и идемпотентность.

          **Пример тела запроса:**

          ```json
          {
            "receive_status": "read"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "notification_id": "notification-001",
            "receive_status": "read"
          }
          ```
        '''
      }
    }
    delivery_preferences = service 'Настройки доставки пользователя' {
      list_opt_outs = service 'GET /users/{user_id}/delivery-opt-outs' {
        summary 'Получить все отказы пользователя от доставки.'
        description '''
          Отсутствие opt-out означает разрешённую доставку. Для SMS и email mobile_application_id отсутствует; для push он определяет конкретное мобильное приложение.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "channel_type": "sms",
                "mobile_application_id": null
              },
              {
                "channel_type": "push",
                "mobile_application_id": "app-001"
              }
            ]
          }
          ```
        '''
      }
      set_opt_out = service 'PUT /users/{user_id}/delivery-opt-outs' {
        summary 'Добавить или удалить отказ пользователя от доставки.'
        description '''
          opted_out=true идемпотентно создаёт opt-out; opted_out=false идемпотентно удаляет его и снова разрешает доставку. channel_type обязателен: sms, push или email. mobile_application_id обязателен только для push и запрещён для SMS/email.

          **Пример тела запроса:**

          ```json
          {
            "channel_type": "push",
            "mobile_application_id": "app-001",
            "opted_out": true
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "channel_type": "push",
            "mobile_application_id": "app-001",
            "opted_out": true
          }
          ```
        '''
      }
    }
    channels = service 'Каналы' {
      list = service 'GET /channels' {
        summary 'Получить список каналов оператора.'
        description '''
          TODO: согласовать отображаемые настройки и пагинацию.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "channel_key": "channel-sms-1",
                "channel_type": "sms",
                "status": "active"
              }
            ]
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      create = service 'POST /channels' {
        summary 'Создать канал уведомлений.'
        description '''
          Для push mobile_application_id обязателен и может использоваться только одним каналом; provider_id приложения должен совпадать с provider_id создаваемого канала. Для SMS и email mobile_application_id запрещён.

          **Пример тела запроса:**

          ```json
          {
            "channel_key": "channel-push-1",
            "channel_type": "push",
            "provider_id": "provider-001",
            "mobile_application_id": "app-001"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "channel_key": "channel-push-1",
            "mobile_application_id": "app-001",
            "status": "provisioning"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /channels/{channel_id}' {
        summary 'Получить настройки и состояние канала.'
        description '''
          TODO: согласовать идентификаторы канала в API.

          **Пример тела ответа:**

          ```json
          {
            "channel_key": "channel-push-1",
            "channel_type": "push",
            "mobile_application_id": "app-001",
            "status": "active"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
    providers = service 'Провайдеры' {
      list = service 'GET /providers' {
        summary 'Получить список провайдеров оператора.'
        description '''
          TODO: определить поля и пагинацию.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "provider_id": "provider-001",
                "type": "sms",
                "status": "active"
              }
            ]
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      create = service 'POST /providers' {
        summary 'Создать конфигурацию провайдера.'
        description '''
          TODO: определить настройки и способ передачи секретов.

          **Пример тела запроса:**

          ```json
          {
            "type": "sms",
            "name": "sms-provider",
            "credentials": {}
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "provider_id": "provider-001",
            "status": "active"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /providers/{provider_id}' {
        summary 'Получить конфигурацию провайдера.'
        description '''
          Секреты в ответе не возвращаются. TODO: определить доступные поля.

          **Пример тела ответа:**

          ```json
          {
            "provider_id": "provider-001",
            "type": "sms",
            "status": "active"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
    applications = service 'Мобильные приложения' {
      list = service 'GET /mobile-applications' {
        summary 'Получить список мобильных приложений.'
        description '''
          TODO: согласовать поля.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "application_id": "app-001",
                "platform": "android",
                "package_name": "example.app"
              }
            ]
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      create = service 'POST /mobile-applications' {
        summary 'Зарегистрировать мобильное приложение.'
        description '''
          TODO: определить настройки для платформ и провайдеров.

          **Пример тела запроса:**

          ```json
          {
            "platform": "android",
            "package_name": "example.app"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "application_id": "app-001",
            "status": "active"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /mobile-applications/{application_id}' {
        summary 'Получить настройки приложения.'
        description '''
          TODO: согласовать поля.

          **Пример тела ответа:**

          ```json
          {
            "application_id": "app-001",
            "platform": "android",
            "package_name": "example.app"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      provider_set = service 'PUT /mobile-applications/{application_id}/provider' {
        summary 'Связать приложение с провайдером.'
        description '''
          TODO: определить правила смены провайдера.

          **Пример тела запроса:**

          ```json
          {
            "provider_id": "provider-001"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "application_id": "app-001",
            "provider_id": "provider-001"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      provider_unset = service 'DELETE /mobile-applications/{application_id}/provider' {
        summary 'Отключить провайдера от приложения.'
        description '''
          TODO: определить влияние на каналы и существующие токены.

          TODO: согласовать код и тело ответа.

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
    admin = service 'Администрирование' {
      operators_list = service 'GET /internal/operators' {
        summary 'Получить список операторов.'
        description '''
          Внутренняя операция. TODO: согласовать модель доступа.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "operator_id": "company-123",
                "name": "Компания"
              }
            ]
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      operators_create = service 'POST /internal/operators' {
        summary 'Создать оператора.'
        description '''
          Внутренняя операция. TODO: согласовать права и процесс подключения.

          **Пример тела запроса:**

          ```json
          {
            "name": "Компания"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "operator_id": "company-123",
            "status": "active"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      keys_create = service 'POST /internal/operator-api-keys' {
        summary 'Выпустить ключ доступа оператора.'
        description '''
          Внутренняя операция. TODO: согласовать выпуск и однократный показ секрета.

          **Пример тела запроса:**

          ```json
          {
            "operator_id": "company-123",
            "name": "service-a"
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "api_key_id": "key-001",
            "api_key": "example-secret"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      keys_revoke = service 'DELETE /internal/operator-api-keys/{api_key_id}' {
        summary 'Отозвать ключ доступа.'
        description '''
          Внутренняя операция. TODO: определить аудит и порядок отзыва.

          TODO: согласовать код и тело ответа.

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
    templates = service 'Шаблоны' {
      list = service 'GET /templates' {
        summary 'Получить список шаблонов.'
        description '''
          TODO: уточнить необходимость и модель шаблонов.

          **Пример тела ответа:**

          ```json
          {
            "items": [
              {
                "template_id": "template-001",
                "key": "hello_template"
              }
            ]
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      create = service 'POST /templates' {
        summary 'Создать шаблон.'
        description '''
          payload поддерживает плейсхолдеры вида `{name}` в строковых значениях. Значения передаются в template.recipient_data при создании inline-рассылки или добавлении порции аудитории. Общие переменные оператора не поддерживаются. TODO: уточнить создание новых версий и жизненный цикл шаблонов.

          **Пример тела запроса:**

          ```json
          {
            "key": "hello_template",
            "channel_type": "sms",
            "payload": {
              "title": "Заявка",
              "body": "Ваша заявка обработана",
              "image_url": "https://example.com/banner.png",
              "data": {"application_id": "123"}
            }
          }
          ```

          **Пример тела ответа:**

          ```json
          {
            "template_id": "template-001"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
      get = service 'GET /templates/{template_id}' {
        summary 'Получить шаблон.'
        description '''
          TODO: уточнить модель и права доступа.

          **Пример тела ответа:**

          ```json
          {
            "template_id": "template-001",
            "key": "hello_template"
          }
          ```

          Примеры предварительные; коды ответов и ошибки требуют согласования.
        '''
      }
    }
  }
}

views {
  view rest_overview of notify.api {
    title 'REST API — группы операций'
    description 'Черновая карта API; контракты и границы доступа предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
  view rest_campaigns of notify.api.campaigns {
    title 'REST API — Рассылки'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
  }
  view rest_history of notify.api.history {
    title 'REST API — История уведомлений'
    description 'Предварительные операции и примеры; пути, права, ошибки и ответы не утверждены.'
    include *
    autoLayout LeftRight
    style status {
      shape rectangle
    }
  }
  view rest_delivery_preferences of notify.api.delivery_preferences {
