// Предварительная доменная модель: поля и методы описывают понятия и правила, не реализацию классов.
model {
  extend notify.domain {
    campaigns = domain 'Рассылки и доставка' {
      campaign = domain 'Campaign' {
        summary 'Рассылка и её жизненный цикл.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          ChannelID uuid.UUID
          Category string
          Content NotificationContent
          Priority Priority // critical | high | normal
          Status CampaignStatus // draft | scheduled | starting | started | completed | failed (предварительно)
          ScheduledAt *time.Time
          DeadlineAt *time.Time
          CancelledAt *time.Time
          RunID *uuid.UUID
          Progress *CampaignProgress
          ```

          **Правила и операции:** создать рассылку; добавлять порции аудитории до запуска; запустить немедленно или запланировать, закрыв загрузку; зафиксировать отмену. `category` — обязательная строка, которую задаёт вызывающая система для последующей фильтрации истории. Перед отправкой и повтором проверяются отмена и дедлайн. Новый `run_id` отсеивает устаревшие запуски.

          TODO: согласовать состояния, переходы, итог отмены и дедлайна, а также правила обработки inline-рассылок.
        '''
      }
      recipient = domain 'Recipient' {
        summary 'Получатель по идентификатору или адресу.'
        description '''
          **Поля (предварительно):**
          ```go
          Type RecipientType // user_id | phone | email | push_token
          Value string
          ```

          **Правила:** пользователь разрешается в адреса по выбранному каналу; анонимный адрес передаётся напрямую. При отсутствии пользователя или подходящего адреса отправка завершается ошибкой.

          TODO: определить проверку адресов и применимость типов к каналам.
        '''
      }
      batch = domain 'RecipientBatch' {
        summary 'Порция получателей рассылки.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          CampaignID uuid.UUID
          RecipientType RecipientType // user_id | phone | email | push_token
          Recipients []string
          ```

          **Правила:** порции добавляются до запуска; при подготовке разворачиваются в задания доставки. `recipients` обязателен для всех типов получателей. TODO: согласовать ограничения размера, идемпотентность и отдельный механизм массовой рассылки всем пользователям.
        '''
      }
      progress = domain 'CampaignProgress' {
        summary 'Прогресс обработки рассылки.'
        description '''
          **Поля (предварительно):**
          ```go
          SourceBatchesTotal int
          SourceBatchesFannedOut int
          DeliveryTotal int
          DeliveryProcessed int
          DeliverySuccessCount int
          DeliveryFailCount int
          DeliveryCanceledCount int
          ```

          **Операции:** учитывать подготовленные порции и текущее состояние сообщений из PostgreSQL; определять завершение обработки. DeliveryCanceledCount включает сообщения, отменённые пользователем, дедлайном или UserDeliveryOptOut. TODO: согласовать правило завершения.
        '''
      }
      work = domain 'DeliveryWork' {
        summary 'Логическое задание доставки.'
        description '''
          **Поля (предварительно):**
          ```go
          DeliveryID uuid.UUID
          NotificationID uuid.UUID
          OperatorID uuid.UUID
          CampaignID *uuid.UUID
          Recipient Recipient
          ChannelID uuid.UUID
          Category string
          Priority Priority // critical | high | normal
          RetryAttempt int
          ```

          **Правила:** `category` переносится из рассылки в историю уведомления. Перед отправкой проверяются настройки UserDeliveryOptOut, ограничения, отмена и дедлайн; при временной ошибке возможно формирование повтора. TODO: уточнить классификацию ошибок.
        '''
      }
      notification = domain 'Notification' {
        summary 'Сообщение со статусом доставки и статусом получения.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          Recipient Recipient
          ChannelID uuid.UUID
          CampaignID *uuid.UUID
          Category string
          Content NotificationContent
          DeliveryStatus DeliveryStatus // pending | success | fail | canceled
          ReceiveStatus *ReceiveStatus // sent | delivered | read
          RetryCount int
          CreatedAt time.Time
          UpdatedAt time.Time
          ```
          `category` передаётся вызывающей системой и позволяет фильтровать историю сообщений. retry_count увеличивается для каждой повторной отправки. receive_status отсутствует, пока сообщение не принято провайдером.

          **Правила:** delivery и retry-воркеры напрямую создают или обновляют delivery_status в PostgreSQL. Перед обращением к провайдеру он равен pending; после попытки — success, fail или canceled. После успешной отправки receive_status устанавливается в sent и затем может перейти в delivered или read. Каждое изменение также публикуется в поток событий для ClickHouse.

          TODO: согласовать допустимые переходы, подтверждения доставки и историю для анонимных получателей.
        '''
      }
      content = domain 'NotificationContent' {
        summary 'Содержимое уведомления.'
        description '''
          **Поля (предварительно):**
          ```go
          Title *string
          Body *string
          ImageURL *string
          Data map[string]string
          ```

          **Правила:** это единый канонический payload для всех каналов. Адаптер канала использует только поддерживаемые поля и не передаёт остальные провайдеру: SMS обычно использует body, email — title, body и image_url, push — все поля. ChannelData и другие канал-специфичные поля не поддерживаются. TODO: определить ограничения размера и обязательность полей для каждого канала.
        '''
      }
    }
    channels = domain 'Каналы и провайдеры' {
      channel = domain 'Channel' {
        summary 'Настроенный канал отправки оператора.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          ChannelKey string
          ChannelType ChannelType // sms | push | email
          ProviderID uuid.UUID
          MobileApplicationID *uuid.UUID // обязателен только для push
          Status ChannelStatus // provisioning | active | disabled
          ```

          **Правила и операции:** канал принадлежит оператору и использует одного провайдера; несколько каналов могут использовать одного провайдера. Push-канал связан ровно с одним мобильным приложением, а мобильное приложение — не более чем с одним push-каналом. Для SMS и email MobileApplicationID отсутствует. Канал можно активировать или отключить; его обработчики следуют состоянию канала. При создании рассылки через REST или Kafka канал выбирается по переданному ключу; без ключа сервис выбирает самый дешёвый подходящий канал указанного типа. TODO: определить расчёт стоимости, момент выбора и поведение, если подходящего канала нет.
        '''
      }
      provider = domain 'Provider' {
        summary 'Конфигурация провайдера доставки оператора.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          ProviderType string
          Settings any
          Status ConfigurationStatus // active | disabled
          RateLimitQPS int
          RateLimitBurst int
          CredentialsEncrypted string
          ```

          **Операции:** включить или отключить провайдера, изменить лимиты и учётные данные. TODO: определить хранение секретов и правила смены конфигурации.
        '''
      }
      application = domain 'MobileApplication' {
        summary 'Мобильное приложение для push-уведомлений.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          Platform MobilePlatform // android | ios
          PackageName string
          ProviderID *uuid.UUID
          Status ConfigurationStatus // active | disabled
          ```

          **Операции:** подключить или отключить провайдера. Push-канал ссылается на приложение напрямую. TODO: согласовать совместимость и влияние смены провайдера.
        '''
      }
    }
    users = domain 'Пользователи и контакты' {
      user = domain 'User' {
        summary 'Локальное представление пользователя оператора.'
        description '''
          **Поля (предварительно):**
          ```go
          OperatorID uuid.UUID
          UserID string
          Status UserStatus // active | deleted
          ```

          **Операции:** создать или обновить проекцию и обработать удаление по внешним событиям. После запуска потребления событий Kafka существующие данные однократно загружаются SQL-скриптом из других баз данных.
        '''
      }
      phone = domain 'UserPhone' {
        summary 'Телефон пользователя и возможные сведения для маршрутизации.'
        description '''
          **Поля (предварительно):**
          ```go
          OperatorID uuid.UUID
          UserID string
          Phone string
          MobileOperator *string
          Region *string
          UpdatedAt time.Time
          ```

          **Операции:** обновить или удалить телефон по событию внешней системы. Оператор мобильной сети и регион необязательны. TODO: определить источник и актуальность сведений, а также их возможное использование при выборе провайдера.
        '''
      }
      email = domain 'UserEmail' {
        summary 'Email пользователя и возможные сведения о почтовом сервисе.'
        description '''
          **Поля (предварительно):**
          ```go
          OperatorID uuid.UUID
          UserID string
          Email string
          MailService *string
          UpdatedAt time.Time
          ```

          **Операции:** обновить или удалить email по событию внешней системы. Почтовый сервис необязателен. TODO: определить источник, актуальность и возможное применение сведений о сервисе.
        '''
      }
      token = domain 'UserPushToken' {
        summary 'Push-токен установки приложения.'
        description '''
          **Поля (предварительно):**
          ```go
          OperatorID uuid.UUID
          UserID string
          MobileApplicationID uuid.UUID
          InstallationID string
          Token string
          Status PushTokenStatus // active | inactive
          UpdatedAt time.Time
          ```

          **Операции:** зарегистрировать, обновить или деактивировать токен. TODO: согласовать источник событий и защиту токенов.
        '''
      }
      delivery_opt_out = domain 'UserDeliveryOptOut' {
        summary 'Явный отказ пользователя от способа доставки.'
        description '''
          **Поля (предварительно):**
          ```go
          OperatorID uuid.UUID
          UserID string
          ChannelType ChannelType // sms | push | email
          MobileApplicationID *uuid.UUID // обязателен только для push
          CreatedAt time.Time
          ```

          **Правила:** отсутствие записи означает разрешённую доставку. Для SMS и email существует один opt-out на пользователя и тип канала. Для push opt-out создаётся отдельно для каждого мобильного приложения. Для push mobile_application_id обязателен; для SMS и email отсутствует. Добавление и удаление opt-out идемпотентны.
        '''
      }
    }
    access = domain 'Операторы и доступ' {
      operator = domain 'Operator' {
        summary 'Оператор сотовой связи, использующий сервис уведомлений.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          Name string
          Status ConfigurationStatus // active | disabled
          RateLimitPerMinute int
          ```

          **Операции:** включить или отключить оператора, изменить лимит. Настройки, каналы и данные принадлежат конкретному оператору.
        '''
      }
      key = domain 'OperatorApiKey' {
        summary 'Ключ доступа вызывающей системы.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          Name string
          KeyHash string
          CreatedAt time.Time
          RevokedAt *time.Time
          ```

          **Операции:** выпустить и отозвать ключ; исходный секрет не хранится. TODO: согласовать права и процесс ротации.
        '''
      }
    }
    templates = domain 'Шаблоны' {
      template = domain 'Template' {
        summary 'Возможный шаблон уведомления оператора.'
        description '''
          **Поля (предварительно):**
          ```go
          ID uuid.UUID
          OperatorID uuid.UUID
          Name string
          ChannelType ChannelType // sms | push | email
          Content NotificationContent
          Version int
          ```

          TODO: уточнить необходимость шаблонов и их роль в сервисе.
        '''
      }
    }
  }

  notify.domain.campaigns.campaign -> notify.domain.access.operator 'Принадлежит оператору'
  notify.domain.campaigns.campaign -> notify.domain.channels.channel 'Использует канал'
  notify.domain.campaigns.batch -> notify.domain.campaigns.campaign 'Принадлежит рассылке'
  notify.domain.campaigns.batch -> notify.domain.campaigns.recipient 'Содержит получателей'
  notify.domain.campaigns.progress -> notify.domain.campaigns.campaign 'Отражает прогресс'
  notify.domain.campaigns.work -> notify.domain.campaigns.recipient 'Адресовано получателю'
  notify.domain.campaigns.work -> notify.domain.channels.channel 'Доставляется через канал'
  notify.domain.campaigns.work -> notify.domain.campaigns.notification 'Идентифицирует уведомление'
  notify.domain.campaigns.notification -> notify.domain.campaigns.content 'Содержит данные'
  notify.domain.channels.channel -> notify.domain.channels.provider 'Использует провайдера'
  notify.domain.channels.application -> notify.domain.channels.provider 'Может использовать провайдера'
  notify.domain.channels.channel -> notify.domain.channels.application 'Для push связан с одним приложением'
  notify.domain.users.user -> notify.domain.access.operator 'Принадлежит оператору'
  notify.domain.users.phone -> notify.domain.users.user 'Принадлежит пользователю'
  notify.domain.users.email -> notify.domain.users.user 'Принадлежит пользователю'
  notify.domain.users.token -> notify.domain.users.user 'Принадлежит пользователю'
  notify.domain.users.token -> notify.domain.channels.application 'Относится к приложению'
  notify.domain.users.delivery_opt_out -> notify.domain.users.user 'Принадлежит пользователю'
  notify.domain.users.delivery_opt_out -> notify.domain.channels.application 'Относится к приложению для push'
  notify.domain.access.key -> notify.domain.access.operator 'Принадлежит оператору'
  notify.domain.templates.template -> notify.domain.access.operator 'Принадлежит оператору'
}

views {
  view domain_overview of notify.domain {
    title 'Notify — доменная модель'
    description 'Предварительные доменные понятия и правила. Типы записаны в нотации Go: uuid.UUID — идентификатор, time.Time — момент времени, указатель обозначает необязательное значение. Значения enum указаны в комментариях; неутверждённые значения и типы any требуют согласования.'
    include *
    autoLayout LeftRight
  }
  view domain_campaigns of notify.domain.campaigns {
    title 'Домен — рассылки и доставка'
    include *
    autoLayout LeftRight
  }
  view domain_channels of notify.domain.channels {
    title 'Домен — каналы и провайдеры'
    include *
    autoLayout LeftRight
  }
  view domain_users of notify.domain.users {
    title 'Домен — пользователи и контакты'
    include *
    autoLayout LeftRight
  }
  view domain_access of notify.domain.access {
    title 'Домен — операторы и доступ'
    include *
    autoLayout LeftRight
  }
  view domain_templates of notify.domain.templates {
    title 'Домен — шаблоны'
    include *
    autoLayout LeftRight
  }
}
