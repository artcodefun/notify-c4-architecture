// Логические назначения Redis; форматы ключей и политики хранения предстоит согласовать.
model {
  extend redis {
    cache = database 'Кэш данных' {
      description 'Кэш для уменьшения чтений PostgreSQL.'
      operators = database 'Операторы' {
        summary 'Кэш настроек и состояния операторов.'
      }
      channels = database 'Каналы' {
        summary 'Кэш настроек каналов операторов.'
      }
      providers = database 'Провайдеры' {
        summary 'Кэш конфигурации провайдеров.'
      }
      applications = database 'Мобильные приложения' {
        summary 'Кэш настроек мобильных приложений.'
      }
      campaigns = database 'Активные рассылки' {
        summary 'Кэш данных выполняющихся рассылок с TTL.'
        description 'Позволяет воркерам реже читать данные активных рассылок из PostgreSQL. При отмене значение cancelled_at должно стать доступно воркерам через обновление или инвалидацию кэша.'
      }
      templates = database 'Шаблоны — под вопросом' {
        summary 'Возможный кэш шаблонов и их версий.'
      }

    }
    limits = database 'Ограничение скорости' {
      description 'Распределённые token bucket на уровнях оператора и провайдера. Разрешения списываются из обоих атомарно одной Lua-операцией с использованием времени Redis.'
      operator = database 'Лимиты операторов' {
        summary 'Общая квота оператора: распределённый token bucket.'
        description 'Ключ: operator:{operator_id}. Квота в минуту переводится в скорость в секунду; bucket пополняется непрерывно.'
      }
      provider = database 'Лимиты провайдеров' {
        summary 'Квота экземпляра провайдера: распределённый token bucket.'
        description 'Ключ: provider:{provider_id}. Скорость QPS и burst задаются конфигурацией провайдера. При нехватке разрешений воркер ждёт доступности; ответ 429 и Retry-After учитываются при планировании повтора.'
      }
    }
  }

  notify.api -> redis.cache 'Использует и обновляет кэш настроек'
  notify.api -> redis.cache.campaigns 'Обновляет или инвалидирует кэш при отмене'
  notify.workers.campaign -> redis.cache.campaigns 'Использует кэш активных рассылок'
  notify.workers.delivery -> redis.cache 'Читает кэш настроек и активных рассылок'
  notify.workers.retry -> redis.cache 'Читает кэш настроек доставки'
  notify.workers.delivery -> redis.limits 'Проверяет лимиты'
  notify.workers.retry -> redis.limits 'Проверяет лимиты'
}

views {
  view redis_overview of redis {
    title 'Redis — назначения'
    description 'Логические данные в Redis; детали хранения и политики предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
  view redis_cache of redis.cache {
    title 'Redis — кэш данных'
    description 'Предполагаемые кэши; кэш шаблонов пока под вопросом.'
    include *
    autoLayout LeftRight
  }
  view redis_limits of redis.limits {
    title 'Redis — ограничение скорости'
    description 'Двухуровневый распределённый token bucket; параметры и поведение при сбоях предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
}
