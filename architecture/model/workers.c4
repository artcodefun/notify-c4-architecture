// Предварительные логические роли: физическое развёртывание и детали сценариев не определены.
model {
  extend notify.workers {
    campaign = service 'Подготовка рассылок' {
      description 'Обрабатывает два независимых контура: batched-рассылки с сохранёнными порциями аудитории и inline-рассылки с неизменяемой аудиторией из запроса. После запуска проверяет актуальность запуска и разворачивает получателей в отдельные задания доставки. Запуск batched-рассылки закрывает загрузку аудитории; задания и результаты подготовки публикуются в Kafka.'
    }
    delivery = service 'Доставка уведомлений' {
      description 'Проверяет cancelled_at и deadline_at перед отправкой, применяет лимиты и отправляет провайдеру. Для просроченных или отменённых заданий не вызывает провайдера и публикует уведомление со статусом cancelled для истории; результат передаётся в прогресс и аналитику. При отсутствии пользователя или адреса фиксирует ошибку.'
    }
    retry = service 'Повторные попытки' {
      description 'Читает отложенные задания и перед повтором проверяет отмену и дедлайн. Предварительная политика: до трёх повторов через 1, 5 и 30 минут; Retry-After провайдера может увеличить задержку. До наступления due_at обработка соответствующей partition приостанавливается. TODO: подтвердить политику ошибок и повторов для SMS и email.'
    }
    progress = service 'Агрегация прогресса' {
      description 'Собирает результаты доставки, формирует прогресс рассылок и обновляет его в PostgreSQL.'
    }
    history = service 'Запись истории уведомлений' {
      description 'Асинхронно сохраняет историю со статусом sent после успешной отправки провайдеру или cancelled при отмене либо истечении дедлайна без отправки. Ожидающие и другие неуспешные отправки в историю не попадают. При сбое после вызова провайдера возможна повторная отправка.'
    }
  }

  notify.workers.campaign -> postgres 'Читает рассылки и порции аудитории'
  notify.workers.delivery -> postgres 'Читает настройки, адреса и содержимое'
  notify.workers.retry -> postgres 'Читает настройки, адреса и содержимое'
  notify.workers.delivery -> push 'Отправляет push'
  notify.workers.delivery -> sms 'Отправляет SMS'
  notify.workers.delivery -> email 'Отправляет письма'
  notify.workers.retry -> push 'Повторяет push'
  notify.workers.retry -> sms 'Повторяет SMS'
  notify.workers.retry -> email 'Повторяет письма'
  notify.workers.progress -> postgres 'Обновляет прогресс рассылок'
  notify.workers.history -> postgres 'Сохраняет историю уведомлений'
}

views {
  view worker_details of notify.workers {
    title 'Notify — роли воркеров'
    description 'Предварительные логические роли; число процессов и конкретные сценарии предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
}
