// Предварительные логические роли: физическое развёртывание и детали сценариев не определены.
model {
  extend notify.workers {
    campaign = service 'Подготовка рассылок' {
      description 'Обрабатывает два независимых контура: batched-рассылки с сохранёнными порциями аудитории и inline-рассылки с неизменяемым inline_batch из PostgreSQL. После запуска проверяет актуальность запуска, разрешает зафиксированную версию шаблона и рендерит payload с данными конкретного адресата; при отсутствии нужной переменной создаёт сообщение со статусом fail. Затем разворачивает получателей в отдельные задания доставки. Запуск batched-рассылки закрывает загрузку аудитории; задания и результаты подготовки публикуются в Kafka.'
    }
    delivery = service 'Доставка уведомлений' {
      description 'Проверяет UserDeliveryOptOut, cancelled_at и deadline_at перед отправкой, применяет лимиты и отправляет провайдеру. При opt-out, отмене или дедлайне не вызывает провайдера и устанавливает delivery_status в canceled. Перед обращением к провайдеру создаёт или обновляет delivery_status сообщения в PostgreSQL на pending, после попытки устанавливает success или fail; при success устанавливает receive_status в sent. Публикует каждое изменение для аналитики. При отсутствии пользователя или адреса фиксирует fail.'
    }
    retry = service 'Повторные попытки' {
      description 'Читает отложенные задания и перед повтором проверяет UserDeliveryOptOut, отмену и дедлайн. После попытки обновляет сообщение в PostgreSQL, в том числе retry_count, и публикует событие для аналитики. Предварительная политика: до трёх повторов через 1, 5 и 30 минут; Retry-After провайдера может увеличить задержку. До наступления due_at обработка соответствующей partition приостанавливается. TODO: подтвердить политику ошибок и повторов для SMS и email.'
    }
  }

  notify.workers.campaign -> postgres 'Читает рассылки и порции аудитории'
  notify.workers.delivery -> postgres 'Читает настройки и сохраняет состояние сообщений'
  notify.workers.retry -> postgres 'Читает настройки и обновляет состояние сообщений'
  notify.workers.delivery -> push 'Отправляет push'
  notify.workers.delivery -> sms 'Отправляет SMS'
  notify.workers.delivery -> email 'Отправляет письма'
  notify.workers.retry -> push 'Повторяет push'
  notify.workers.retry -> sms 'Повторяет SMS'
  notify.workers.retry -> email 'Повторяет письма'
}

views {
  view worker_details of notify.workers {
    title 'Notify — роли воркеров'
    description 'Предварительные логические роли; число процессов и конкретные сценарии предстоит согласовать.'
    include *
    autoLayout LeftRight
  }
}
