model {
  clients -> notify.api 'Отправляют запросы и получают статусы' {
    technology 'REST / HTTP'
  }
  notify.api -> notify.management 'Передаёт запросы'
  notify.api -> notify.channels 'Передаёт запросы управления каналами и провайдерами'
  notify.channels -> postgres 'Сохраняет и читает настройки каналов и провайдеров'
  notify.channels -> notify.workers 'Управляет обработчиками каналов'
  notify.consumer -> notify.management 'Передаёт команды'
  notify.management -> postgres 'Читает и сохраняет данные'
  notify.scheduler -> postgres 'Ищет рассылки, готовые к запуску'
  notify.analytics -> clickhouse 'Сохраняет аналитические данные'
  notify -> telemetry 'Передаёт телеметрию'
  telemetry -> monitoring 'Передаёт данные наблюдаемости'
}

