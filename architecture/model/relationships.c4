  notify.api -> postgres 'Читает и сохраняет данные и настройки'
  notify.scheduler -> postgres 'Ищет рассылки, готовые к запуску'
  notify.delivery_statistics -> clickhouse 'Сохраняет аналитические данные'
  notify.api -> notify.telemetry_collection 'Передаёт метрики, логи и трассировки'
