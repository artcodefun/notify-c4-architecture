// Черновик: имена, структуры и топология подлежат согласованию. JSON — примеры, не контракты.
model {
  user_service = system 'Сервис пользователей (ЕСА)' {
    description 'Источник данных о пользователях и их контактах для Notify.'
  }
  extend kafka {
    user_events = broker 'Внешние события пользователей' {
      description 'Сервис пользователей публикует изменения; Notify поддерживает локальную проекцию.'
      lifecycle = broker 'users.lifecycle.v1' {
        summary 'Сервис пользователей → consumer Notify. Создание, изменение или удаление пользователя.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "event_id": "evt-001",
            "operator_id": "company-123",
            "occurred_at": "2026-11-10T12:00:00Z",
            "type": "user.created",
            "user_id": "user-456"
          }
          ```
        '''
      }
      phones = broker 'users.phone.v1' {
        summary 'Сервис пользователей → consumer Notify. Изменение или удаление телефона.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "event_id": "evt-001",
            "operator_id": "company-123",
            "occurred_at": "2026-11-10T12:00:00Z",
            "type": "user.phone.updated",
            "user_id": "user-456",
            "phone": "+15550102030"
          }
          ```
        '''
      }
      emails = broker 'users.email.v1' {
        summary 'Сервис пользователей → consumer Notify. Изменение или удаление email.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "event_id": "evt-001",
            "operator_id": "company-123",
            "occurred_at": "2026-11-10T12:00:00Z",
            "type": "user.email.updated",
            "user_id": "user-456",
            "email": "user@example.com"
          }
          ```
        '''
      }
      tokens = broker 'users.push-token.v1' {
        summary 'Сервис пользователей → consumer Notify. Обновление или удаление push-токена.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "event_id": "evt-001",
            "operator_id": "company-123",
            "occurred_at": "2026-11-10T12:00:00Z",
            "type": "user.push_token.updated",
            "user_id": "user-456",
            "installation_id": "device-789",
            "platform": "android",
            "token": "example-token"
          }
          ```
        '''
      }
    }
    campaign_requests = broker 'Внешнее управление рассылками' {
      description 'Запросы других сервисов на создание inline-рассылок.'
      send = broker 'notify.campaign.inline.create.v1' {
        summary 'Внешний сервис → consumer Notify. Запрос на inline-рассылку по типу канала.'
        description '''
          Необязательный `campaign_id` — UUID, который вызывающий сервис задаёт, если хочет отслеживать последующие изменения рассылки; при наличии он также обеспечивает идемпотентность: повтор того же запроса не создаёт новую рассылку. Без campaign_id Notify создаёт внутренний идентификатор рассылки. Обязательны channel_type (sms, push или email), строковая category, recipient_type (user_id, phone, email или push_token) и непустой recipients. Необязательный channel_key задаёт конкретный канал оператора; без него сервис выбирает самый дешёвый подходящий канал указанного типа. deadline_at необязателен. Если пользователя или адреса нет, соответствующая отправка завершается ошибкой.

          **Пример сообщения — черновик:**

          ```json
          {
            "campaign_id": "018f6b7a-6d80-7ac1-9e15-c1261cd9b021",
            "operator_id": "company-123",
            "type": "campaign.inline.create",
            "channel_type": "sms",
            "channel_key": "channel-sms-twilio-325",
            "category": "informational",
            "recipient_type": "user_id",
            "recipients": ["user-456"],
            "deadline_at": "2026-11-10T13:00:00Z",
            "payload": {
              "title": "Заявка",
              "body": "Ваша заявка обработана"
            }
          }
          ```
        '''
      }
    }
    campaigns = broker 'Внутренние топики рассылок' {
      description 'Два независимых набора топиков: batched — для рассылок с сохранёнными порциями аудитории, inline — для небольших рассылок с аудиторией в запросе. Все внутренние записи Notify используют envelope: верхнеуровневые type и schema_version, а полезные данные — в payload. Scheduler сохраняет новый run_id в PostgreSQL и публикует batched-запуск в Kafka; проверка fencing и восстановление повторяют запуск при сбоях. Это не единая транзакция PostgreSQL и Kafka.'
      batched_run = broker 'notify.campaign.batched.run.v1' {
        summary 'Планировщик → worker. Запуск рассылки с сохранёнными порциями после наступления времени отправки.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "campaign_run_requested",
            "schema_version": 1,
            "payload": {
              "campaign_id": "campaign-001",
              "run_id": "run-001"
            }
          }
          ```
        '''
      }
      batched_fanout = broker 'notify.campaign.batched.fanout.v1' {
        summary 'Worker → worker. Разворачивание одной сохранённой порции в задания доставки.'
        description '''
          Событие адресует одну сохранённую порцию аудитории. Оно намеренно не дублирует campaign_id, operator_id и run_id: consumer загружает порцию и связанные с ней данные из PostgreSQL.

          **Пример сообщения — черновик:**

          ```json
          {
            "type": "campaign_batch_fanout",
            "schema_version": 1,
            "payload": {
              "batch_id": "batch-001"
            }
          }
          ```
        '''
      }
      inline_run = broker 'notify.campaign.inline.run.v1' {
        summary 'Kafka consumer → worker. Запуск inline-рассылки после её создания.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "campaign_run_requested",
            "schema_version": 1,
            "payload": {
              "campaign_id": "campaign-001",
              "run_id": "run-001"
            }
          }
          ```
        '''
      }
      inline_fanout = broker 'notify.campaign.inline.fanout.v1' {
        summary 'Worker → worker. Разворачивание аудитории inline-рассылки в задания доставки.'
        description '''
          Inline-аудитория неизменяема после создания кампании, поэтому событие несёт campaign_id и recipients; worker загружает остальные данные кампании из PostgreSQL.

          **Пример сообщения — черновик:**

          ```json
          {
            "type": "campaign_inline_fanout",
            "schema_version": 1,
            "payload": {
              "campaign_id": "campaign-001",
              "recipients": ["user-456", "user-789"]
            }
          }
          ```
        '''
      }
    }
    channels = broker 'Внутренние топики доставки' {
      description 'Для каждого настроенного канала оператора создаются три топика доставки по приоритетам и три топика повторов по интервалам. Все внутренние записи используют envelope: верхнеуровневые type и schema_version, а полезные данные — в payload.'
      delivery_critical = broker 'notify.delivery.critical.{channel_id}' {
        summary 'Задания доставки приоритета critical для конкретного канала оператора.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "delivery_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "critical",
              "retry_attempt": 0
            }
          }
          ```
        '''
      }
      delivery_high = broker 'notify.delivery.high.{channel_id}' {
        summary 'Задания доставки приоритета high для конкретного канала оператора.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "delivery_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "high",
              "retry_attempt": 0
            }
          }
          ```
        '''
      }
      delivery_normal = broker 'notify.delivery.normal.{channel_id}' {
        summary 'Задания доставки приоритета normal для конкретного канала оператора.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "delivery_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "normal",
              "retry_attempt": 0
            }
          }
          ```
        '''
      }
      retry_1m = broker 'notify.retry.1m.{channel_id}' {
        summary 'Повторные попытки для конкретного канала; интервал 1m.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "retry_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "normal",
              "retry_attempt": 1,
              "due_at": "2026-11-10T12:01:00Z"
            }
          }
          ```
        '''
      }
      retry_5m = broker 'notify.retry.5m.{channel_id}' {
        summary 'Повторные попытки для конкретного канала; интервал 5m.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "retry_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "normal",
              "retry_attempt": 1,
              "due_at": "2026-11-10T12:05:00Z"
            }
          }
          ```
        '''
      }
      retry_30m = broker 'notify.retry.30m.{channel_id}' {
        summary 'Повторные попытки для конкретного канала; интервал 30m.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "retry_work",
            "schema_version": 1,
            "payload": {
              "delivery_id": "delivery-001",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "operator_id": "company-123",
              "user_id": "user-456",
              "channel_id": "channel-sms-1",
              "category": "informational",
              "priority": "normal",
              "retry_attempt": 1,
              "due_at": "2026-11-10T12:30:00Z"
            }
          }
          ```
        '''
      }
    }
    delivery_events = broker 'Внутренние топики аналитики' {
      description 'Все изменения состояния сообщений публикуются для аналитики в ClickHouse. Запись сообщения и обновление прогресса происходят напрямую в PostgreSQL; отдельных топиков progress, stats и history нет. Все внутренние записи Notify используют envelope: верхнеуровневые type и schema_version, а полезные данные — в payload.'
      events = broker 'notify.delivery.events.v1' {
        summary 'Изменения состояния сообщений и повторы для аналитики.'
        description '''
          **Пример сообщения — черновик:**

          ```json
          {
            "type": "delivery_event",
            "schema_version": 1,
            "payload": {
              "event_id": "evt-001",
              "event_type": "message_status_changed",
              "operator_id": "company-123",
              "occurred_at": "2026-11-10T12:00:00Z",
              "delivery_id": "delivery-002",
              "notification_id": "notification-001",
              "campaign_id": "campaign-001",
              "channel": "sms",
              "retry_count": 1,
              "delivery_status": "fail",
              "receive_status": null,
              "failure_reason": "provider_unavailable"
            }
          }
          ```
        '''
      }
    }
  }

  user_service -> kafka.user_events.lifecycle 'Публикует изменения'
  kafka.user_events.lifecycle -> notify.consumer 'Передаёт события'
  user_service -> kafka.user_events.phones 'Публикует изменения'
  kafka.user_events.phones -> notify.consumer 'Передаёт события'
  user_service -> kafka.user_events.emails 'Публикует изменения'
  kafka.user_events.emails -> notify.consumer 'Передаёт события'
  user_service -> kafka.user_events.tokens 'Публикует изменения'
  kafka.user_events.tokens -> notify.consumer 'Передаёт события'
  notify.consumer -> postgres 'Обновляет локальные данные пользователей и контактов'
  clients -> kafka.campaign_requests.send 'Публикуют запросы inline-рассылок'
  kafka.campaign_requests.send -> notify.consumer 'Передаёт запросы inline-рассылок'
  notify.scheduler -> kafka.campaigns.batched_run 'Публикует задание запуска рассылки с порциями'
  kafka.campaigns.batched_run -> notify.workers.campaign 'Передаёт задание запуска рассылки с порциями'
  notify.workers.campaign -> kafka.campaigns.batched_fanout 'Публикуют задания разворачивания сохранённых порций'
  kafka.campaigns.batched_fanout -> notify.workers.campaign 'Передаёт задания разворачивания сохранённых порций'
  notify.api -> kafka.campaigns.inline_run 'Публикует задание запуска REST inline-рассылки'
  notify.consumer -> kafka.campaigns.inline_run 'Публикует задание запуска inline-рассылки'
  kafka.campaigns.inline_run -> notify.workers.campaign 'Передаёт задание запуска inline-рассылки'
  notify.workers.campaign -> kafka.campaigns.inline_fanout 'Публикуют задания разворачивания inline-аудитории'
  kafka.campaigns.inline_fanout -> notify.workers.campaign 'Передаёт задания разворачивания inline-аудитории'
  notify.provisioner -> kafka.channels 'Создаёт и проверяет топики каналов' {
    description 'При отключении канала топики автоматически не удаляются, сообщения остаются в Kafka до истечения срока хранения.'
  }
  notify.workers.campaign -> kafka.channels.delivery_critical 'Публикуют задания доставки'
  kafka.channels.delivery_critical -> notify.workers.delivery 'Передаёт задания доставки'
  notify.workers.campaign -> kafka.channels.delivery_high 'Публикуют задания доставки'
  kafka.channels.delivery_high -> notify.workers.delivery 'Передаёт задания доставки'
  notify.workers.campaign -> kafka.channels.delivery_normal 'Публикуют задания доставки'
  kafka.channels.delivery_normal -> notify.workers.delivery 'Передаёт задания доставки'
  notify.workers.delivery -> kafka.channels.retry_1m 'Публикуют задания на повтор'
  kafka.channels.retry_1m -> notify.workers.retry 'Передаёт задания на повтор'
  notify.workers.retry -> kafka.channels.retry_1m 'Публикует последующие повторы'
  notify.workers.delivery -> kafka.channels.retry_5m 'Публикуют задания на повтор'
  kafka.channels.retry_5m -> notify.workers.retry 'Передаёт задания на повтор'
  notify.workers.retry -> kafka.channels.retry_5m 'Публикует последующие повторы'
  notify.workers.delivery -> kafka.channels.retry_30m 'Публикуют задания на повтор'
  kafka.channels.retry_30m -> notify.workers.retry 'Передаёт задания на повтор'
  notify.workers.retry -> kafka.channels.retry_30m 'Публикует последующие повторы'
  notify.workers.delivery -> kafka.delivery_events.events 'Публикуют изменения состояния сообщений'
  notify.workers.retry -> kafka.delivery_events.events 'Публикует изменения состояния сообщений'
  kafka.delivery_events.events -> notify.delivery_statistics 'Передаёт события для аналитики'
}

views {
  view kafka_overview of kafka {
    title 'Kafka — группы потоков'
    description 'Черновая логическая группировка; физическое размещение не определено.'
    include *
    autoLayout LeftRight
  }
  view kafka_user_events of kafka.user_events {
    title 'Kafka — Внешние события пользователей'
    description 'Предварительные топики и примеры сообщений; контракты не согласованы.'
    include *
    autoLayout LeftRight
  }
  view kafka_campaign_requests of kafka.campaign_requests {
    title 'Kafka — Внешнее управление рассылками'
    description 'Предварительные топики и примеры сообщений; контракты не согласованы.'
    include *
    autoLayout LeftRight
  }
  view kafka_campaigns of kafka.campaigns {
    title 'Kafka — Внутренние топики рассылок'
    description 'Предварительные топики и примеры сообщений; контракты не согласованы.'
    include *
    autoLayout LeftRight
  }
  view kafka_channels of kafka.channels {
    title 'Kafka — Внутренние топики доставки'
    description 'Предварительные топики и примеры сообщений; контракты не согласованы.'
    include *
    autoLayout LeftRight
  }
  view kafka_delivery_events of kafka.delivery_events {
    title 'Kafka — Внутренние топики аналитики'
    description 'События изменений состояния сообщений для аналитики в ClickHouse.'
    include *
    autoLayout LeftRight
  }
}
