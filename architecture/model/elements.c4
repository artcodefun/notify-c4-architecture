model {
  clients = system 'Вызывающие системы' {
    description 'Сервисы разных компаний: отправляют запросы на уведомления'
  }
  notify = system 'Notify' {
    description 'Мультиоператорский сервис доставки уведомлений'
    api = service 'REST API' {
      description 'Приём запросов и предоставление статусов'
    }
    consumer = service 'Kafka consumer' {
      description 'Приём запросов inline-рассылок и событий пользователей из Kafka'
    }
    domain = domain 'Доменная модель' {
      description 'Понятия Notify, их данные и бизнес-правила; логическая модель, а не отдельный исполняемый компонент.'
    }
    scheduler = service 'Планировщик рассылок' {
      description 'Ищет готовые рассылки в PostgreSQL и инициирует запуск через Kafka. Fencing run_id и восстановление защищают от устаревших запусков; PostgreSQL и Kafka не образуют общую транзакцию.'
    }
    workers = service 'Delivery workers' {
      description 'Обрабатывают рассылки и задания доставки, повторы, прогресс и историю уведомлений.'
    }
    provisioner = service 'Провиженер каналов' {
      description 'Периодически сверяет состояние каналов с PostgreSQL, обеспечивает наличие Kafka-топиков, запускает и останавливает обработчики каналов. При отключении канала обработчики останавливаются, топики автоматически не удаляются; сообщения хранятся в соответствии с retention Kafka.'
    }
    delivery_statistics = service 'Сбор статистики доставок' {
      description 'Логическая роль воркера: обрабатывает события доставки и передаёт их в ClickHouse. TODO: определить механизм загрузки и состав данных.'
    }
    telemetry_collection = module 'Сбор аналитики' {
      description 'Программный компонент сбора технических метрик, логов и трассировок Notify и передачи их внешнему сборщику телеметрии.'
    }
  }
  kafka = broker 'Kafka' {
    description 'Внешние запросы рассылок и задания доставки; логическое представление'
     icon tech:kafka-icon
  }
  postgres = database 'PostgreSQL' {
    description 'Сообщения и их состояния доставки, настройки операторов, рассылки и каналы'
    icon tech:postgresql
  }
  redis = database 'Redis' {
    description 'Кэш и ограничение частоты запросов'
    icon tech:redis
  }
  clickhouse = database 'ClickHouse' {
    description 'Аналитические данные о доставке'
    icon https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/clickhouse.svg
  }
  telemetry = observability 'Сбор телеметрии' {
    description 'Метрики, логи и трассировки; например, OpenTelemetry Collector'
  }
  monitoring = observability 'Мониторинг' {
    description 'Просмотр метрик и логов, оповещения; например, Grafana'
  }
  push = system 'Push-провайдеры' {
    description 'Доставка мобильных push-уведомлений'
  }
  sms = system 'SMS-провайдеры' {
    description 'Доставка SMS'
  }
  email = system 'Email-провайдеры' {
    description 'Доставка электронной почты'
  }

}

views {
  view notify_details of notify {
    title 'Notify — внутреннее устройство'
    description 'Логические роли Notify и связанные системы; размещение и состав процессов пока не определены.'
    include *
    autoLayout LeftRight
  }
}
